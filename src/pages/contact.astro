---
import SiteLayout from '../layouts/SiteLayout.astro';
import contact from '../data/contact.json';
---

<SiteLayout title="Contact" current="contact">
  <div class="container contact-page">
    <div class="contact-content">
      <h1>Contact</h1>
      <div class="contact-introduction">
        {contact.introduction.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
      <section class="contact-recruitment" aria-labelledby="join-us">
        <h2 id="join-us">Join Us</h2>
        <p>{contact.recruitment}</p>
        <p class="contact-email">
          <span>Email:</span>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
      </section>
    </div>
  </div>
</SiteLayout>

<style>
  .contact-page {
    padding-block: 64px 88px;
  }
  .contact-content {
    max-width: 860px;
  }
  h1 {
    font: 56px/1.12 var(--serif);
    letter-spacing: -1.6px;
    margin-bottom: 32px;
  }
  p {
    font-size: 17px;
    line-height: 1.85;
    color: var(--muted);
  }
  .contact-introduction p + p {
    margin-top: 20px;
  }
  .contact-recruitment {
    margin-top: 44px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }
  h2 {
    font: 34px/1.2 var(--serif);
    color: var(--green);
    margin-bottom: 20px;
  }
  .contact-email {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 24px;
  }
  .contact-email a {
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    overflow-wrap: anywhere;
  }
  .contact-email a:hover {
    text-decoration-thickness: 2px;
  }
  @media (max-width: 760px) {
    .contact-page {
      padding-block: 40px 48px;
    }
    h1 {
      font-size: 44px;
      margin-bottom: 24px;
    }
    p {
      font-size: 16px;
    }
    .contact-recruitment {
      margin-top: 32px;
      padding-top: 24px;
    }
    h2 {
      font-size: 30px;
    }
  }
</style>
