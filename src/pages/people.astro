---
import SiteLayout from '../layouts/SiteLayout.astro';
import PeopleCard from '../components/PeopleCard.astro';
import PersonDialog from '../components/PersonDialog.astro';
import PersonLinks from '../components/PersonLinks.astro';
import peopleData from '../data/people.json';
import { peopleSchema, peoplePhotoPath } from '../lib/people';
import { sitePath } from '../lib/paths';

const people = peopleSchema.parse(peopleData);
---

<SiteLayout title="People" current="people">
  <div class="container people-page">
    <h1>People</h1>
    {people.sections.map((section) => (
      <section
        class:list={['people-section', `people-section-${section.id}`]}
        aria-labelledby={`${section.id}-title`}
      >
        <h2 id={`${section.id}-title`}>{section.title}</h2>
        {section.id === 'pi' ? (
          section.members.map((member) => (
            <div class="people-featured">
              <a
                class="people-featured-photo"
                href={sitePath(`people/${member.id}`)}
                data-person-open={member.id}
                aria-label={`Open the profile of ${member.name}`}
              >
                <div class="people-photo">
                  <img
                    src={peoplePhotoPath(member.photo)}
                    alt={`Photo of ${member.name}`}
                    loading="eager"
                    decoding="async"
                    width="960"
                    height="1200"
                  />
                </div>
              </a>
              <div class="people-featured-info">
                <a
                  class="people-featured-name"
                  href={sitePath(`people/${member.id}`)}
                  data-person-open={member.id}
                >
                  <h3 class="people-name">{member.name}</h3>
                  {member.role && <p class="people-role">{member.role}</p>}
                </a>
                <div class="people-bio">
                  {member.bio.map((paragraph) => <p>{paragraph}</p>)}
                </div>
                <PersonLinks member={member} />
              </div>
            </div>
          ))
        ) : (
          <ul class="people-grid">
            {section.members.map((member) => (
              <li>
                <PeopleCard member={member} />
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
    <PersonDialog />
  </div>
</SiteLayout>

<style>
  .people-page {
    padding-block: 64px 88px;
  }
  h1 {
    font: 56px/1.12 var(--serif);
    letter-spacing: -1.6px;
    margin-bottom: 40px;
  }
  .people-section + .people-section {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  h2 {
    font: 34px/1.2 var(--serif);
    color: var(--green);
    margin-bottom: 24px;
  }

  .people-featured {
    display: grid;
    grid-template-columns: minmax(220px, 300px) 1fr;
    gap: 36px;
    align-items: start;
  }
  .people-featured-photo .people-photo {
    aspect-ratio: 4 / 5;
    background: #f3f5f0;
    overflow: hidden;
    transition: box-shadow 0.25s ease;
  }
  .people-featured-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }
  .people-featured-photo:hover img,
  .people-featured-photo:focus-visible img {
    transform: scale(1.03);
  }
  .people-featured-name {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .people-featured-name .people-name {
    font: 30px/1.2 var(--serif);
    letter-spacing: -0.4px;
  }
  .people-featured-name:hover .people-name,
  .people-featured-name:focus-visible .people-name {
    color: var(--green);
  }
  .people-bio {
    margin-top: 14px;
  }
  .people-bio p {
    font-size: 16px;
    line-height: 1.85;
    color: var(--muted);
  }
  .people-bio p + p {
    margin-top: 10px;
  }

  .people-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 36px 28px;
    align-items: stretch;
  }
  .people-grid li {
    display: flex;
  }
  .people-grid li > :global(.people-cell) {
    width: 100%;
  }

  @media (max-width: 760px) {
    .people-page {
      padding-block: 40px 48px;
    }
    h1 {
      font-size: 44px;
      margin-bottom: 24px;
    }
    h2 {
      font-size: 30px;
    }
    .people-grid {
      grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
      gap: 28px 18px;
    }
    .people-featured {
      grid-template-columns: minmax(160px, 220px) 1fr;
      gap: 20px;
    }
    .people-featured-name .people-name {
      font-size: 24px;
    }
    .people-bio p {
      font-size: 15px;
    }
  }
  @media (max-width: 560px) {
    .people-featured {
      grid-template-columns: 1fr;
    }
  }
</style>
