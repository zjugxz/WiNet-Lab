---
import SiteLayout from '../layouts/SiteLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import NetworkArt from '../components/NetworkArt.astro';
import home from '../data/home.json';
import { sitePath } from '../lib/paths';
---

<SiteLayout title="Home" current="">
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="status-dot"></span>
          {home.eyebrow}
        </p>
        <h1 id="hero-title">
          {home.headline.split('\n').map((line, index) => (
            <span class:list={{ 'accent-text': index === 1 }}>{line}</span>
          ))}
        </h1>
        <p class="hero-description">{home.introduction}</p>
        <a class="button" href={sitePath('research')}>
          Explore our research <span aria-hidden="true">↗</span>
        </a>
        <p class="preview-note">
          Homepage prototype · Introductory copy for review
        </p>
      </div>
      <figure class="hero-visual">
        <NetworkArt />
        <figcaption>
          <span>01 / Connected ideas</span>
          <span>Illustrative visual</span>
        </figcaption>
      </figure>
    </section>
    <section class="about section" aria-labelledby="about-title">
      <div>
        <p class="eyebrow">About the group</p>
        <h2 id="about-title">{home.about.title}</h2>
      </div>
      <div class="about-copy">
        <p>{home.about.text}</p>
        <p class="content-note">{home.about.note}</p>
        <a class="text-link" href={sitePath('people')}>
          Meet the group <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
    <section class="section news-section" aria-labelledby="news-title">
      <SectionHeading number="01" title="News" id="news-title">
        <span class="section-caption">{home.news.caption}</span>
      </SectionHeading>
      <div class="news-empty">
        <span class="empty-symbol" aria-hidden="true">
          ↗
        </span>
        <div>
          <h3>{home.news.title}</h3>
          <p>{home.news.description}</p>
        </div>
        <span class="pill">{home.news.status}</span>
      </div>
    </section>
    <section class="section events-section" aria-labelledby="events-title">
      <SectionHeading number="02" title="Events" id="events-title">
        <span class="section-caption">{home.events.caption}</span>
      </SectionHeading>
      <div class="event-preview">
        <div class="event-art" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <i>W / G</i>
        </div>
        <div class="event-copy">
          <p class="eyebrow">{home.events.eyebrow}</p>
          <h3>{home.events.title}</h3>
          <p>{home.events.description}</p>
          <span class="pill">{home.events.status}</span>
        </div>
        <div class="event-margin" aria-hidden="true">
          EXCHANGE · EXPLORE · CONNECT
        </div>
      </div>
    </section>
    <section
      class="section collaborators-section"
      aria-labelledby="collaborators-title"
    >
      <SectionHeading
        number="03"
        title="Collaborators"
        id="collaborators-title"
      />
      <div class="collaborators-empty">
        <span class="collab-icon" aria-hidden="true">
          ◎
        </span>
        <div>
          <h3>{home.collaborators.title}</h3>
          <p>{home.collaborators.description}</p>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>
