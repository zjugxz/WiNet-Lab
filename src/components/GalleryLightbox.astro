---
---

<gallery-lightbox>
  <dialog aria-labelledby="gallery-lightbox-caption">
    <div class="lightbox-top">
      <p class="lightbox-caption" id="gallery-lightbox-caption"></p>
      <button
        class="close-button"
        type="button"
        data-lightbox-close
        aria-label="Close photo"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="m5 5 10 10M15 5 5 15"></path>
        </svg>
      </button>
    </div>
    <div class="lightbox-stage">
      <button
        class="nav-button"
        type="button"
        data-lightbox-prev
        aria-label="Previous photo"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="m12 4-6 6 6 6"></path>
        </svg>
      </button>
      <img data-lightbox-photo alt="" decoding="async" />
      <button
        class="nav-button"
        type="button"
        data-lightbox-next
        aria-label="Next photo"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="m8 4 6 6-6 6"></path>
        </svg>
      </button>
    </div>
    <p class="lightbox-counter" role="status" data-lightbox-counter></p>
  </dialog>
</gallery-lightbox>

<script>
  import galleryData from '../data/gallery.json';
  import type { GalleryGroup } from '../lib/gallery';

  type GalleryPhotoRef = {
    photoId: string;
    src: string;
    alt: string;
    groupTitle: string;
  };

  class GalleryLightbox extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const dialog = this.querySelector('dialog')!;
      if (typeof dialog.showModal !== 'function') return;
      const image = this.querySelector<HTMLImageElement>(
        '[data-lightbox-photo]',
      )!;
      const caption = this.querySelector('.lightbox-caption')!;
      const counter = this.querySelector('[data-lightbox-counter]')!;
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      const photos: GalleryPhotoRef[] = [];
      // The empty groups array is inferred as never[]; cast for future data.
      const groups = galleryData.groups as GalleryGroup[];
      for (const group of groups)
        for (const photo of group.photos)
          photos.push({
            photoId: photo.id,
            src: `${base}/${photo.src}`,
            alt: photo.alt,
            groupTitle: group.title,
          });
      if (photos.length === 0) return;
      let index = 0;
      let opener: HTMLElement | null = null;

      const render = () => {
        const photo = photos[index];
        image.src = photo.src;
        image.alt = photo.alt;
        caption.textContent = photo.groupTitle;
        counter.textContent = `${index + 1} / ${photos.length}`;
      };
      const show = (photoId: string, source: HTMLElement) => {
        const next = photos.findIndex((photo) => photo.photoId === photoId);
        if (next === -1) return;
        index = next;
        opener = source;
        render();
        dialog.showModal();
      };
      const move = (delta: number) => {
        index = (index + delta + photos.length) % photos.length;
        render();
      };

      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const thumb = event.target.closest<HTMLElement>('[data-gallery-open]');
        if (!thumb) return;
        event.preventDefault();
        show(thumb.dataset.galleryOpen!, thumb);
      });
      this.querySelector('[data-lightbox-close]')!.addEventListener(
        'click',
        () => dialog.close(),
      );
      this.querySelector('[data-lightbox-prev]')!.addEventListener('click', () =>
        move(-1),
      );
      this.querySelector('[data-lightbox-next]')!.addEventListener('click', () =>
        move(1),
      );
      dialog.addEventListener('close', () => {
        image.removeAttribute('src');
        caption.textContent = '';
        counter.textContent = '';
        opener?.focus({ preventScroll: true });
        opener = null;
      });
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') move(-1);
        else if (event.key === 'ArrowRight') move(1);
      });
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom
        )
          dialog.close();
      });
    }
  }
  if (!customElements.get('gallery-lightbox'))
    customElements.define('gallery-lightbox', GalleryLightbox);
</script>

<style>
  gallery-lightbox {
    display: contents;
  }
  dialog {
    width: min(1000px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 18px 18px 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    background: white;
    box-shadow: 0 20px 70px #18221c33;
  }
  dialog::backdrop {
    background: #18221c99;
  }
  .lightbox-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 12px;
  }
  .lightbox-caption {
    font: 17px/1.3 var(--serif);
    color: var(--green);
  }
  .close-button {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: white;
    cursor: pointer;
  }
  .lightbox-stage {
    display: grid;
    grid-template-columns: 40px 1fr 40px;
    gap: 10px;
    align-items: center;
  }
  .lightbox-stage img {
    display: block;
    width: 100%;
    max-height: calc(100dvh - 160px);
    object-fit: contain;
    border-radius: 4px;
    background: #f3f5f0;
  }
  .nav-button {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: white;
    cursor: pointer;
  }
  .nav-button:hover {
    background: var(--green);
    color: white;
    border-color: var(--green);
  }
  .nav-button svg,
  .close-button svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.5;
    fill: none;
  }
  .lightbox-counter {
    margin-top: 10px;
    font-size: 12px;
    color: var(--muted);
    text-align: center;
  }
  @media (max-width: 560px) {
    .lightbox-stage {
      grid-template-columns: 32px 1fr 32px;
      gap: 6px;
    }
    .nav-button {
      width: 32px;
      height: 32px;
    }
  }
</style>
