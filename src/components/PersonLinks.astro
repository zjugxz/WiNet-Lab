---
import type { PeopleMember } from '../lib/people';

interface Props {
  member: PeopleMember;
  /** "icons" renders compact square buttons under cards; "labeled" renders
   *  icon+text buttons on the static detail page. Empty when no link data. */
  variant?: 'icons' | 'labeled';
}
const { member, variant = 'icons' } = Astro.props;

const links = [
  member.website && {
    key: 'website',
    href: member.website,
    label: `Personal website of ${member.name}`,
    text: 'Website',
    icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z',
  },
  {
    key: 'email',
    href: `mailto:${member.email}`,
    label: `Email ${member.name}`,
    text: 'Email',
    icon: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm-1 2 10 7L22 7',
  },
  member.googleScholar && {
    key: 'scholar',
    href: member.googleScholar,
    label: `${member.name} on Google Scholar`,
    text: 'Google Scholar',
    icon: 'm22 9-10-5L2 9l10 5 10-5ZM6 11.5V16c0 1.7 2.7 3 6 3s6-1.3 6-3v-4.5M22 9v5',
  },
].filter(Boolean) as { key: string; href: string; label: string; text: string; icon: string }[];
---
{links.length > 0 && (
  <div class:list={['person-links', `person-links-${variant}`]}>
    {links.map(({ key, href, label, text, icon }) => (
      <a
        class="person-link"
        href={href}
        aria-label={label}
        title={label}
        target={key === 'email' ? undefined : '_blank'}
        rel={key === 'email' ? undefined : 'noopener noreferrer'}
        data-person-link={key}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none">
          <path d={icon} />
        </svg>
        {variant === 'labeled' && <span>{text}</span>}
      </a>
    ))}
  </div>
)}
<style>
  .person-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .person-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 34px;
    height: 34px;
    border: 1px solid var(--line);
    border-radius: 6px;
    color: var(--green);
    background: white;
  }
  .person-link svg {
    width: 17px;
    height: 17px;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .person-link:hover,
  .person-link:focus-visible {
    border-color: var(--green);
    background: var(--green);
    color: white;
  }
  .person-link:focus-visible {
    outline: 3px solid var(--green);
    outline-offset: 2px;
  }
  .person-links-labeled .person-link {
    width: auto;
    min-height: 32px;
    padding: 4px 12px;
    font-size: 13px;
  }
</style>
