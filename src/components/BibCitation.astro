---
import { bibtexPath, getBibtex } from '../lib/citations';

interface Props {
  citationId: string;
  title: string;
  headingId: string;
}
const { citationId, title, headingId } = Astro.props;
const bibtex = getBibtex(citationId);
const href = bibtexPath(citationId);
const filename = `${citationId}.bib`;
---

<bib-citation>
  <a
    class="bib-button"
    data-bib-open
    href={href}
    download={filename}
    aria-label={`Bib: Cite ${title}`}
  >
    <svg viewBox="0 0 20 20" aria-hidden="true" fill="none">
      <path d="M7 4H5a2 2 0 0 0-2 2v3H1m6 7H5a2 2 0 0 1-2-2v-3H1M13 4h2a2 2 0 0 1 2 2v3h2m-6 7h2a2 2 0 0 0 2-2v-3h2M9 8h2v4H9z" />
    </svg>
    Bib
  </a>
  <dialog aria-labelledby={headingId} aria-describedby={`${headingId}-paper`}>
    <div class="citation-header">
      <h2 id={headingId}>Cite this paper</h2>
      <button
        class="close-button"
        type="button"
        data-bib-close
        aria-label="Close citation"
      >
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="m5 5 10 10M15 5 5 15" />
        </svg>
      </button>
    </div>
    <p class="citation-title" id={`${headingId}-paper`}>
      {title}
    </p>
    <label for={`${headingId}-text`}>BibTeX</label>
    <textarea
      id={`${headingId}-text`}
      readonly
      spellcheck="false"
      rows="12"
    >{bibtex}</textarea>
    <div class="citation-actions">
      <button class="bib-button copy-button" type="button" data-bib-copy>
        Copy BibTeX
      </button>
      <a class="bib-button" href={href} download={filename}>
        Download .bib
      </a>
    </div>
    <p class="copy-status" role="status" aria-live="polite" data-bib-status></p>
  </dialog>
</bib-citation>

<script>
  class BibCitation extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const opener = this.querySelector<HTMLAnchorElement>('[data-bib-open]')!;
      const dialog = this.querySelector('dialog')!;
      const text = this.querySelector('textarea')!;
      const status = this.querySelector<HTMLElement>('[data-bib-status]')!;
      const copy = this.querySelector<HTMLButtonElement>('[data-bib-copy]')!;
      // Without JavaScript (or dialog support), Bib remains a native download.
      if (typeof dialog.showModal !== 'function') return;
      opener.setAttribute('role', 'button');
      opener.setAttribute('aria-haspopup', 'dialog');
      const open = () => {
        status.textContent = '';
        dialog.showModal();
      };
      opener.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey)
          return;
        event.preventDefault();
        open();
      });
      opener.addEventListener('keydown', (event) => {
        if (event.key !== ' ') return;
        event.preventDefault();
        open();
      });
      this.querySelector('[data-bib-close]')!.addEventListener('click', () =>
        dialog.close(),
      );
      dialog.addEventListener('close', () =>
        opener.focus({ preventScroll: true }),
      );
      dialog.addEventListener('keydown', (event) => {
        if (event.key !== 'Tab') return;
        const controls = dialog.querySelectorAll<HTMLElement>(
          'button:not(:disabled), a[href], textarea',
        );
        const first = controls[0];
        const last = controls[controls.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });
      dialog.addEventListener('click', (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (
          event.clientX < bounds.left ||
          event.clientX > bounds.right ||
          event.clientY < bounds.top ||
          event.clientY > bounds.bottom
        )
          dialog.close();
      });
      copy.addEventListener('click', async () => {
        copy.disabled = true;
        try {
          await navigator.clipboard.writeText(text.value);
          if (dialog.open) status.textContent = 'BibTeX copied.';
        } catch {
          if (dialog.open) {
            text.focus();
            text.select();
            status.textContent =
              'Copy unavailable. Copy the selected text manually, or download the .bib file.';
          }
        } finally {
          copy.disabled = false;
        }
      });
    }
  }
  if (!customElements.get('bib-citation'))
    customElements.define('bib-citation', BibCitation);
</script>

<style>
  bib-citation {
    display: inline-flex;
  }
  .bib-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 30px;
    padding: 4px 9px;
    border: 1px solid var(--green);
    border-radius: 4px;
    background: white;
    color: var(--green);
    font:
      12px/1.5 Arial,
      Helvetica,
      sans-serif;
    cursor: pointer;
  }
  .bib-button:hover {
    background: var(--green);
    color: white;
  }
  .bib-button svg {
    width: 14px;
    height: 14px;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  dialog {
    width: min(680px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    margin: auto;
    padding: 28px;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    background: white;
    box-shadow: 0 20px 70px #18221c33;
  }
  dialog::backdrop {
    background: #18221c99;
  }
  .citation-header {
    display: flex;
    align-items: center;
    gap: 16px;
    justify-content: space-between;
  }
  h2 {
    font: 28px/1.2 var(--serif);
    color: var(--green);
  }
  .close-button {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: white;
    cursor: pointer;
  }
  .close-button svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .citation-title {
    margin: 16px 0 22px;
    font: 17px/1.5 var(--serif);
    overflow-wrap: anywhere;
  }
  label {
    display: block;
    margin-bottom: 8px;
    color: #a45122;
    font: italic 700 15px/1.4 var(--serif);
  }
  textarea {
    display: block;
    width: 100%;
    height: 280px;
    max-height: 45dvh;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: #f5f7f4;
    color: var(--ink);
    font:
      12px/1.7 Consolas,
      'Courier New',
      monospace;
    resize: vertical;
    overflow-wrap: anywhere;
  }
  textarea:focus-visible {
    outline: 3px solid var(--green);
    outline-offset: 2px;
  }
  .citation-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }
  .citation-actions .bib-button {
    min-height: 36px;
  }
  .copy-button {
    background: var(--green);
    color: white;
  }
  .copy-status {
    min-height: 20px;
    margin-top: 10px;
    font-size: 12px;
    color: var(--green);
  }
  @media (max-width: 480px) {
    dialog {
      padding: 18px;
    }
    h2 {
      font-size: 24px;
    }
  }
</style>
