---
import site from '../data/site.json';
import { sitePath } from '../lib/paths';
import Mark from './Mark.astro';
const words = site.name.trim().split(/\s+/);
---

<a class="brand" href={sitePath()} aria-label={`${site.name} home`}>
  <Mark />
  <span class="brand-name">
    {words.map((word) => (
      <span>{word}</span>
    ))}
  </span>
</a>
