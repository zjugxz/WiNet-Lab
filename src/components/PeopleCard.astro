---
import type { PeopleMember } from '../lib/people';
import { peoplePhotoPath } from '../lib/people';
import { sitePath } from '../lib/paths';
import PersonLinks from './PersonLinks.astro';

interface Props {
  member: PeopleMember;
}
const { member } = Astro.props;
---

<div class="people-cell">
  <a
    class="people-card"
    href={sitePath(`people/${member.id}`)}
    data-person-open={member.id}
  >
    <div class="people-photo">
      <img
        src={peoplePhotoPath(member.photo)}
        alt={`Photo of ${member.name}`}
        loading="lazy"
        decoding="async"
        width="960"
        height="1200"
      />
    </div>
    <div class="people-info">
      <h3 class="people-name">{member.name}</h3>
      {member.role && <p class="people-role">{member.role}</p>}
    </div>
  </a>
  <!-- Outside the card anchor: nested links would be invalid HTML. -->
  <PersonLinks member={member} />
</div>

<style>
  .people-cell {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .people-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }
  .people-photo {
    aspect-ratio: 4 / 5;
    background: #f3f5f0;
    overflow: hidden;
  }
  .people-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }
  .people-card:hover .people-photo img,
  .people-card:focus-visible .people-photo img {
    transform: scale(1.03);
  }
  .people-info {
    padding-top: 12px;
  }
  .people-name {
    font: 19px/1.25 var(--serif);
    letter-spacing: -0.2px;
  }
  .people-card:hover .people-name,
  .people-card:focus-visible .people-name {
    color: var(--green);
  }
  .people-role {
    margin-top: 4px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green);
  }
</style>
