---
// Injected only by scripts/check-text-links.mjs; never a published route.
import SiteLayout from '../../src/layouts/SiteLayout.astro';
import EmphasisText from '../../src/components/EmphasisText.astro';

const samples = [
  'Visit [Zhejiang University](https://www.zju.edu.cn/english/) for details.',
  'A **bold phrase** and a link to [the paper page](https://example.com/paper?a=1&b=%E4%B8%AD) together.',
  'Reference style [DOI link](https://doi.org/10.1145/3704413.3764420).',
  'Bold outside: **[Professor](https://example.com/prof)**, bold inside: [**Doctor**](https://example.com/doc).',
  'Rejected markers stay literal: [x](javascript:alert(1)) [y](ftp://example.com) [z](/research/).',
];
---

<SiteLayout title="Text link check" current="home">
  <div class="container">
    <h1>Text link component check</h1>
    {samples.map((text) => (
      <p><EmphasisText {text} /></p>
    ))}
  </div>
</SiteLayout>
